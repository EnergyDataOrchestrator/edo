# ---------------------------------------------------------------------------
# projects-ds.ttl — Apache Jena Fuseki dataset definition for the EDO prototype
#
# Serves:
#   * a TDB2 dataset `<projects>` at   /projects
#     where the EDO internal-format instance graphs (maDMP + SMS → internal
#     format) are loaded.
# Provide via the Jena text index for full-text search (not used yet — keep
# simple; enable with jena:indexText in the service + a text:index block).
#
# SHACL shapes live in ../shapes/project-claim-shapes.ttl and are exposed by
# Fuseki itself (pyshacl / the Docker container can talk to them), but the
# simplest validation route for the prototype is the shapes graph defined
# below as a *named dataset* so the query endpoint can serve it, plus direct
# pyshacl against ../shapes/ on the host.
#
# ---------------------------------------------------------------------------
@prefix f:    <http://jena.apache.org/config#> .
@prefix j:    <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix ja:   <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .

# --- Main dataset: EDO internal-format instances -----------------------------
<#projectsDB> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "db/projects" ;
    tdb2:unionDefaultGraph true .

<#projectsService> rdf:type fuseki:Service ;
    fuseki:name "projects" ;
    fuseki:dataset <#projectsDB> ;
    fuseki:endpoint fuseki:query ;
    fuseki:endpoint fuseki:update ;
    fuseki:endpoint fuseki:upload ;
    fuseki:endpoint fuseki:data .

# --- Shapes dataset (read-side): SHACL node shapes for project claims --------
# Exposed at /shapes so you can query /shapes/query or (with pyshacl) point at
# the local file instead. Keeping shapes in its own Fuseki *dataset* keeps
# instance data and constraints separate.
# The absolute path resolves because FUSEKI_BASE=/fuseki and ./shapes is
# mounted at /fuseki/shapes (see docker-compose.yml).
<#shapesDB> rdf:type ja:MemoryModel ;
    ja:content [ ja:externalContent <file:/fuseki/shapes/project-claim-shapes.ttl> ] .

<#shapesService> rdf:type fuseki:Service ;
    fuseki:name "shapes" ;
    fuseki:dataset <#shapesDB> ;
    fuseki:endpoint fuseki:query ;
    fuseki:endpoint fuseki:data .

<#server> rdf:type fuseki:Server ;
    fuseki:services (
        <#projectsService>
        <#shapesService>
    ) .
